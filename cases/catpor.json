      "expected": {
        "access": "reject",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7; §4.3.1.2",
        "reason": "'If another claim is referenced and that claim is not present ... the token is not well-formed.' Not well-formed -> not valid -> not acceptable (§4.3.1.2)."
      }
    },
    {
      "id": "CATPOR-MAL-06",
      "title": "Reference to non-bstr claim (exp)",
      "category": "malformed",
      "claims_edn": "{309: [0, 4]}",
      "expected": {
        "access": "reject",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7; §4.3.1.2",
        "reason": "Referenced claim 4 (exp) is an integer, not a byte string: not well-formed, so not valid (§4.3.1.2)."
      }
    },
    {
      "id": "CATPOR-MAL-07",
      "title": "Text label reference to absent claim",
      "category": "malformed",
      "claims_edn": "{309: [0, \"cti\"]}",
