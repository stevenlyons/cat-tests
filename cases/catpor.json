      "title": "Probability 0.5",
      "category": "statistical",
      "claims_edn": "{309: [0.5, h'087ee44f239f7a2e34b3d1649aad8c1d']}",
      "expected": {
        "access": "probabilistic",
        "basis": "normative-text",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Rejected with probability 0.5; check over many trials.",
        "probability_of_rejection": 0.5
      }
    },
    {
      "id": "CATPOR-STAT-02",
      "title": "Probability 0.25",
      "category": "statistical",
      "claims_edn": "{309: [0.25, h'087ee44f239f7a2e34b3d1649aad8c1d']}",
      "expected": {
        "access": "probabilistic",
        "basis": "normative-text",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Rejected with probability 0.25; check over many trials.",
        "probability_of_rejection": 0.25
      }
    },
    {
      "id": "CATPOR-STAT-03",
      "title": "Spec example probability 0.00005",
      "category": "statistical",
      "claims_edn": "{309: [0.00005, h'087ee44f239f7a2e34b3d1649aad8c1d', 1700000000]}",
