{
  "claim": "catpor",
  "claim_key": 309,
  "ticket": "VCC-1475",
  "rules_source": "CTA-5007-B §4.6.7 (reuse blocking out of scope: tracked outside VCL)",
  "cases": [
    {
      "id": "CATPOR-ACC-01",
      "title": "Probability 0 with bstr id",
      "category": "accept",
      "claims_edn": "{309: [0, h'087ee44f239f7a2e34b3d1649aad8c1d']}",
      "expected": {
        "access": "accept",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Rejected with probability equal to the value: 0 means never rejected."
      }
    },
    {
      "id": "CATPOR-ACC-02",
      "title": "Probability 0 with bstr id and expiry",
      "category": "accept",
      "claims_edn": "{309: [0, h'087ee44f239f7a2e34b3d1649aad8c1d', 4102444800]}",
      "expected": {
        "access": "accept",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Optional third member is a NumericDate; probability 0."
      }
    },
    {
      "id": "CATPOR-ACC-03",
      "title": "Probability 0 referencing cti (bstr)",
      "category": "accept",
      "claims_edn": "{309: [0, 7]}",
      "expected": {
        "access": "accept",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Integer id references claim 7 (cti), which is present and a bstr."
      }
    },
    {
      "id": "CATPOR-ACC-04",
      "title": "Probability 0 with past catpor expiry",
      "category": "accept",
      "claims_edn": "{309: [0, h'087ee44f239f7a2e34b3d1649aad8c1d', 1700000000]}",
      "expected": {
        "access": "accept",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "catpor-exp only bounds how long a blocked value is remembered (reuse blocking, out of scope); it does not make the token unacceptable."
      }
    },
    {
      "id": "CATPOR-ACC-05",
      "title": "Probability 0 referencing a text-keyed bstr claim",
      "category": "accept",
      "claims_edn": "{\"ref\": h'0102030405', 309: [0, \"ref\"]}",
      "expected": {
        "access": "accept",
        "basis": "CDDL",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "catpor-id = label / bstr; label = int / tstr. The text label \"ref\" references a present bstr claim."
      }
    },
    {
      "id": "CATPOR-REJ-01",
      "title": "Probability 1 with bstr id",
      "category": "reject",
      "claims_edn": "{309: [1, h'087ee44f239f7a2e34b3d1649aad8c1d']}",
      "expected": {
        "access": "reject",
        "basis": "normative-text",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "'A catpor claim is rejected with probability equal to that value': 1 means always rejected."
      }
    },
    {
      "id": "CATPOR-REJ-02",
      "title": "Probability 1 referencing cti",
      "category": "reject",
      "claims_edn": "{309: [1, 7]}",
      "expected": {
        "access": "reject",
        "basis": "normative-text",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Probability 1 with a valid cti reference: always rejected."
      }
    },
    {
