        "access": "reject",
        "basis": "MUST",
        "spec_ref": "CTA-5007-B §4.6.7",
        "reason": "Probability below 0: not well-formed, MUST be rejected."
      }
    },
    {
      "id": "CATPOR-MAL-03",
      "title": "Probability 2 (integer)",
      "category": "malformed",
      "claims_edn": "{309: [2, h'087ee44f239f7a2e34b3d1649aad8c1d']}",
      "expected": {
        "access": "reject",
        "basis": "MUST",
        "spec_ref": "CTA-5007-B §4.6.7",
