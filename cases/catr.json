        "access": "reject",
        "basis": "MUST NOT",
        "spec_ref": "CTA-5007-B §4.9.2; §4.6.11",
        "reason": "Access rejected by catm; 'Recipients MUST NOT renew an unacceptable token.'",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-07",
      "title": "Expired token with catr",
      "category": "reject",
