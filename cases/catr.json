      "expected": {
        "access": "accept",
        "basis": "MUST NOT",
        "spec_ref": "CTA-5007-B §4.9.2",
        "reason": "'If a renewal deadline is present, the token MUST also have an exp claim ... If it does not, the recipient MUST NOT renew the token.'",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-02",
      "title": "Redirect renewal, token in header",
      "category": "accept",
      "claims_edn": "{323: {0: 3, 1: 3600, 2: 4000000000}}",
      "expected": {
        "access": "accept",
        "basis": "MUST NOT",
        "spec_ref": "CTA-5007-B §4.9.2.4",
        "reason": "'If the token is not in the URI, a redirect renewal claim in that token MUST NOT be processed.'",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-03",
      "title": "Automatic renewal with additional parameters",
      "category": "accept",
      "claims_edn": "{323: {0: 0, 1: 3600, 2: 4000000000, 5: [\"Secure\"]}}",
      "expected": {
        "access": "accept",
        "basis": "interpretation",
        "spec_ref": "CTA-5007-B §4.9.2.1",
        "reason": "Issuer rule: 'A token with automatic renewal MUST not have an additional parameters parameter'. The recipient's handling is not stated; read as 'parameters not appropriate' -> MUST NOT renew. Confirm.",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-04",
      "title": "Header renewal with a cookie-name parameter",
      "category": "accept",
      "claims_edn": "{323: {0: 2, 1: 3600, 2: 4000000000, 3: \"cat\"}}",
      "expected": {
        "access": "accept",
        "basis": "MUST NOT",
        "spec_ref": "CTA-5007-B §4.9.2",
        "reason": "'A recipient MUST NOT renew a token based on a catr claim that has parameters that are not appropriate for the renewal type.'",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-05",
      "title": "Cookie parameter with illegal ';'",
      "category": "accept",
      "claims_edn": "{323: {0: 1, 1: 3600, 2: 4000000000, 5: [\"Path=/;Domain=evil.example\"]}}",
      "expected": {
        "access": "accept",
        "basis": "MUST NOT",
        "spec_ref": "CTA-5007-B §4.9.2.2",
        "reason": "Recipients MUST validate cookie parameters (RFC 6265 §5.2); if they cannot be safely added, MUST NOT renew.",
        "renewal_decision": "MUST NOT renew"
      }
    },
    {
      "id": "CATR-NOR-06",
      "title": "Otherwise unacceptable token (catm POST, request GET)",
      "category": "reject",
      "claims_edn": "{313: [\"POST\"], 323: {0: 0, 1: 3600, 2: 4000000000}}",
