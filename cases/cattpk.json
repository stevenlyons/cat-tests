    {
      "id": "CATTPK-UND-01",
      "title": "Intermediate SPKI, chain [self-signed leaf, intermediate] (chain does not validate)",
      "category": "undefined",
      "claims_edn": "{319: h'${spki:intermediate}'}",
      "request": {
        "tls": {
          "alpn": "h2",
          "client_chain": [
