      "needs": [
        "mtls"
      ],
      "expected": {
        "access": "accept",
        "basis": "MUST",
        "spec_ref": "CTA-5007-B §4.6.18",
        "reason": "A certificate in the client chain matches."
      }
    },
    {
      "id": "CATTPK-ACC-02",
