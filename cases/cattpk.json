        "mtls"
      ],
      "expected": {
        "access": "undefined",
        "basis": "interpretation",
        "spec_ref": "CTA-5007-B §4.6.18",
        "reason": "Anyone can append a public intermediate to the chain they send. §4.6.18 does not say whether the chain must validate. Expected result needs a Fastly decision."
      }
